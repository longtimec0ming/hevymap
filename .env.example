HEVY_API_KEY=
ACCESS_PASSWORD=

# Optional. Encrypts the cookie used when a visitor connects their own Hevy
# API key in-app (used only when HEVY_API_KEY above is unset — see README's
# "Bring your own API key" section). If ACCESS_PASSWORD is set, that's used
# instead and this can stay unset. If neither is set, a random secret is
# generated per server process, which means every connected key is lost on
# restart/redeploy — set this on any real deployment to avoid that.
# HEVYMAP_SECRET=
